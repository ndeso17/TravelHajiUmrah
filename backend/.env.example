# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/hajiumroh

# JWT (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# File storage
STORAGE_PATH=./uploads

# Video hero (stream aman — origin gate + token short-lived)
HERO_VIDEO_PATH=assets/video/Hero.mp4
HERO_VIDEO_SECRET=

# WA Gateway (opsional — kosongkan untuk stub dev)
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# SMTP (opsional — kosongkan untuk stub dev)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# CORS + origin gate (daftar origin frontend, dipisah koma)
FRONTEND_ORIGINS=http://localhost:5173
PORT=3000